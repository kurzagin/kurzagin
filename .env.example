# ============================================================
# kurzagin.log — Environment Configuration for Neon & Vercel
# Copy this file to .env.local:
#   cp .env.example .env.local
# ============================================================

# 1. Neon Database Connection String (from Neon Console)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Neon Managed Auth Configuration (from Neon Console > Auth tab)
# The base URL of your Managed Better Auth service
NEON_AUTH_BASE_URL="https://ep-sample.neonauth.us-east-2.aws.neon.tech"

# 3. Secret key for signing session data cookies (minimum 32 characters)
# Generate with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET="generate-a-secure-32-character-minimum-secret-key-here"

# 4. (Optional) Legacy fallback secret
AUTH_SECRET="your-legacy-secret-key-here"

# 5. Cloudflare R2 Object Storage (Media, Opus Audio & AVIF Album Art)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="kurzagin-media"
# Public URL base for accessing media (custom domain or https://pub-xxx.r2.dev)
R2_PUBLIC_URL="https://cdn.kurzagin.com"
